skin rose

scale max 4096*4096

!$ideaCanvas = "#191a1c"

!if $BASE_BACKGROUND == "$BASE_BACKGROUND"
    !$BASE_BACKGROUND = "transparent"
!else
    !if $BASE_BACKGROUND == "$ideaCanvas"
        !$BASE_BACKGROUND = $ideaCanvas
    !endif
!endif


skinparam defaultfontcolor #brown
skinparam backgroundcolor $BASE_BACKGROUND
skinparam arrowfontcolor #0F8C29
skinparam wrapwidth 180
skinparam titlefontcolor dodgerblue

skinparam note<<q>> {
    backgroundcolor lightsalmon
    fontcolor navy
}

skinparam note<<code>> {
    fontcolor mediumslateblue
    fontstyle bold
    fontname monospaced
}


<style>
element {
  MaximumWidth 180
}
note {
  MaximumWidth 200
  .wide {
    MaximumWidth 500
  }
}
</style>

!if $SHOW_TITLE

    !$diagramFileName = %splitstr(%filename(),'.')
    !if %size($diagramFileName) > 0
        !$titleString = $diagramFileName[0]

        !if %size($diagramFileName) == 3
            !$titleString = $titleString + " " + $diagramFileName[1] + " diagram"
        !endif
        title $titleString
'        title $SHOW_TITLE
    !endif
!endif

