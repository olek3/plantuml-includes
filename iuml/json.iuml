!if $BASE_BACKGROUND == ""
$BASE_BACKGROUND = transparent
!endif

<style>
    jsondiagram {
        backgroundcolor $BASE_BACKGROUND
        node {
            linecolor forestgreen
            backgroundcolor darkgray
            fontcolor blue
        }
        arrow{
            linecolor steelblue
            linethickness 4
        }
    }
    highlight {
        backgroundcolor #paleturquoise
    }

</style>

!$jsonFIleName=""

!$splitName=%splitstr(%filename(),'.')
!$i = 0

!while $i < %size($splitName)-1
    !if %size($jsonFIleName) > 0
        !$jsonFIleName = $jsonFIleName+'.'
    !endif
    !$jsonFIleName = $jsonFIleName+$splitName[$i]
    !$i = $i + 1
!endwhile
!$dir = %dirpath() + "\"

!if $dir == "\" || %file_exists($dir+$jsonFIleName)
!include $jsonFIleName
!endif
